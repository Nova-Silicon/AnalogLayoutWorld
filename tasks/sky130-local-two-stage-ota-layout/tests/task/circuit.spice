XMN6 vout vx vss vss sky130_fd_pr__nfet_01v8 w=3 l=0.5 m=15 nf=1
XMP6 vout vbias_p vdd vdd sky130_fd_pr__pfet_01v8 w=3 l=0.5 m=72 nf=1
